---
// Cada palabra se ilumina al pasar por el centro de la pantalla (CSS scroll-driven animations).
// Los fragmentos entre **asteriscos** se destacan en color.
const PARAGRAPHS = [
  {
    es: "Soy desarrollador web fullstack. Me gusta **convertir ideas en productos** que la gente realmente use, desde la primera charla con el cliente hasta el deploy.",
    en: "I'm a fullstack web developer. I enjoy **turning ideas into products** people actually use, from the first conversation with the client to deployment.",
  },
  {
    es: "Trabajo con **JavaScript y TypeScript** en todo el stack: Astro y Next.js en el frontend, NestJS y Node en el backend, y React Native para mobile. Me importa tanto **cómo se ve** como **cómo funciona por dentro**.",
    en: "I work with **JavaScript and TypeScript** across the stack: Astro and Next.js on the frontend, NestJS and Node on the backend, and React Native for mobile. I care as much about **how it looks** as about **how it works under the hood**.",
  },
  {
    es: "Hoy estudio **Ingeniería en Informática** en la UNAJ y **Desarrollo de Videojuegos** en la UTN, donde exploro interacción, gameplay y sistemas en tiempo real.",
    en: "I'm currently studying **Computer Engineering** at UNAJ and **Video Game Development** at UTN, where I explore interaction, gameplay and real-time systems.",
  },
];

// Divide por espacios para que la puntuación quede pegada a su palabra ("dentro**." -> "dentro.")
const toWords = (text: string) => {
  let highlight = false;
  return text.split(/\s+/).map((raw) => {
    const isHighlight = highlight || raw.startsWith("**");
    if ((raw.match(/\*\*/g) ?? []).length % 2 === 1) highlight = !highlight;
    return { word: raw.replaceAll("**", ""), highlight: isHighlight };
  });
};
---

<div class="about-text flex flex-col gap-8">
  {PARAGRAPHS.map((paragraph) =>
    (["es", "en"] as const).map((lang) => (
      <p data-lang={lang} class="text-pretty text-2xl font-medium leading-snug tracking-tight text-gray-900 dark:text-white md:text-[2rem] md:leading-tight">
        {toWords(paragraph[lang]).map(({ word, highlight }) => (
          <>
            <span class:list={["reveal-word", highlight && "is-highlight"]}>{word}</span>{" "}
          </>
        ))}
      </p>
    )),
  )}
</div>

<style>
  .is-highlight {
    color: rgb(79 70 229);
  }

  :global(.dark) .is-highlight {
    color: rgb(253 224 71);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal-word {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: cover 10% cover 35%;
      }
    }
  }

  @keyframes reveal {
    from {
      opacity: 0.15;
    }
    to {
      opacity: 1;
    }
  }
</style>
