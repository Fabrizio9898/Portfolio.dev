---
import MailIcon from "@/components/icons/Mail.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import GitHub from "@/components/icons/Github.astro";

const EMAIL = "fabrizioandrade9898@gmail.com";
---

<section
  id="contacto"
  class="scroll-m-20 overflow-hidden rounded-3xl border border-black/10 bg-gradient-to-br from-indigo-50 via-white to-amber-50 px-6 py-14 text-center dark:border-white/10 dark:from-indigo-950/60 dark:via-slate-900 dark:to-slate-900 md:px-12 md:py-20"
>
  <h2 class="m-0 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl" data-i18n="CONTACT_TITLE">
    ¿Tenés un proyecto en mente?
  </h2>
  <p class="mx-auto mt-4 max-w-xl text-pretty text-gray-600 dark:text-gray-300" data-i18n="CONTACT_TEXT">
    Landing, sistema de reservas, panel de administración o una app a medida: contame qué necesitás y lo armamos.
  </p>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a
      href={`mailto:${EMAIL}`}
      class="inline-flex items-center gap-2 rounded-full bg-indigo-600 px-6 py-3 font-medium text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2"
    >
      <MailIcon class="size-5" />
      <span data-i18n="CONTACT_CTA">Escribime</span>
    </a>
    <div class="flex gap-3">
      <a
        href="https://www.linkedin.com/in/fabrizio-andrade/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-black/10 px-5 py-3 font-medium text-gray-800 transition hover:bg-black/5 dark:border-white/15 dark:text-gray-100 dark:hover:bg-white/10"
      >
        <LinkedInIcon class="size-5" /> LinkedIn
      </a>
      <a
        href="https://github.com/Fabrizio9898"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-black/10 px-5 py-3 font-medium text-gray-800 transition hover:bg-black/5 dark:border-white/15 dark:text-gray-100 dark:hover:bg-white/10"
      >
        <GitHub class="size-5" /> GitHub
      </a>
    </div>
  </div>

  <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">{EMAIL}</p>
</section>
