---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: { es: "Nov 2024 — Actualidad", en: "Nov 2024 — Present" },
    title: { es: "Desarrollador Web Freelance", en: "Freelance Web Developer" },
    company: { es: "Independiente", en: "Self-employed" },
    description: {
      es: "Diseño y desarrollo sitios y sistemas a medida para clientes: landings, sistemas de reservas, paneles con CMS y APIs. Me encargo del proceso completo, desde entender qué necesita el negocio hasta el deploy y el mantenimiento.",
      en: "I design and build custom websites and systems for clients: landing pages, booking systems, CMS-powered dashboards and APIs. I handle the whole process, from understanding what the business needs to deployment and maintenance.",
    },
    stack: ["Astro", "Next.js", "NestJS", "Payload CMS", "React Native", "TypeScript"],
  },
];
---

<ol class="ranking-list relative mt-6">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-6">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

<style>
  .ranking-list {
    padding-left: 1rem;
  }
</style>
