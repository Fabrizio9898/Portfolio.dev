---
import Localized from "@/components/Localized.astro";

type Text = { es: string; en: string };

interface Props {
  title: Text;
  company: Text;
  date: Text;
  description?: Text;
  stack?: string[];
}

const { title, company, date, description, stack } = Astro.props;
const hasDetails = Boolean(description || stack);
---

<div
  class:list={[
    "relative mx-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]",
    hasDetails ? "pb-12" : "pb-4",
  ]}
>
  <div class:list={["relative md:col-span-2", hasDetails && "pb-12"]}>
    <div class="sticky top-0">
      <span class="text-yellow-400 -left-[42px] absolute rounded-full text-5xl">&bull;</span>

      <h3 class="text-xl font-bold text-yellow-400">
        <Localized text={title} />
      </h3>

      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">
        <Localized text={company} />
      </h4>

      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">
        <Localized text={date} />
      </time>
    </div>
  </div>

  {hasDetails && (
    <div class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
      {description && <p><Localized text={description} /></p>}

      {stack && (
        <ul class="mt-2 flex flex-wrap gap-2">
          {stack.map((tech) => (
            <li class="rounded-full border border-black/10 px-2.5 py-1 text-xs dark:border-white/15">{tech}</li>
          ))}
        </ul>
      )}
    </div>
  )}
</div>
