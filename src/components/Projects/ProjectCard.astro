---
import type { Project } from "@/lib/projects";
import { projectUrl, STATUS_KEYS } from "@/lib/projects";
import { TAGS } from "@/data/tags";
import ProjectMedia from "./ProjectMedia.astro";
import Localized from "./Localized.astro";

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager } = Astro.props;
const { title, summary, stack, status, featured, category } = project.data;
const stackNames = stack.map((key) => TAGS[key as keyof typeof TAGS]?.name ?? key);
---

<a
  href={projectUrl(project.id)}
  class:list={[
    "project-card group flex flex-col gap-4 rounded-2xl p-2 transition duration-300",
    "hover:bg-black/[0.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:hover:bg-white/[0.04]",
    featured && "md:col-span-2",
  ]}
  data-category={category}
>
  <div class="transition duration-500 ease-out md:group-hover:-translate-y-1 md:group-hover:shadow-xl rounded-xl">
    <ProjectMedia project={project} aspect={featured ? "aspect-[16/9]" : "aspect-[16/10]"} eager={eager} />
  </div>

  <div class="flex flex-col gap-2 px-1 pb-2">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold leading-snug text-gray-900 dark:text-white md:text-xl">
        <Localized text={title} />
      </h3>
      <span
        class="mt-1 shrink-0 rounded-full border border-black/10 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:border-white/15 dark:text-gray-300"
        data-i18n={STATUS_KEYS[status]}
      >
        {status}
      </span>
    </div>

    <p class="text-pretty text-sm text-gray-600 dark:text-gray-400 md:text-base">
      <Localized text={summary} />
    </p>

    <div class="mt-1 flex items-center justify-between gap-3">
      <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-mono text-gray-500 dark:text-gray-500">
        {stackNames.slice(0, 4).map((name) => <li>{name}</li>)}
      </ul>
      <span class="flex shrink-0 items-center gap-1 text-sm font-medium text-indigo-600 dark:text-indigo-400">
        <span data-i18n="PROJECT_VIEW">Ver proyecto</span>
        <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </div>
  </div>
</a>
