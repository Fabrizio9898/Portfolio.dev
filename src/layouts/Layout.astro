---
import "@fontsource-variable/onest";
import Header from "../components/Header/Header.astro";
import Languages from "@/components/Languages/Languages.astro";
import Footer from "@/components/Footer/Footer.astro";

interface Props {
  title: string;
  description: string;
  showHeader?: boolean; // Nueva prop opcional
  image?: string;
}

const { title, description, showHeader = true, image = "/fotodeperfil.webp" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Aplica el idioma guardado antes de pintar, para que no parpadee el contenido [data-lang]
      try {
        const lang = localStorage.getItem("language");
        if (lang === "en" || lang === "es") document.documentElement.lang = lang;
      } catch {}
    </script>
  </head>
  <body class="relative bg-white text-black dark:bg-slate-950 dark:text-white">
    <div class="fixed inset-0 z-[-2]">
      <!-- Modo claro (predeterminado) -->
      <div class="relative h-full w-full bg-white dark:hidden">
        <div
          class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_0%,#000_70%,transparent_100%)]"
        >
        </div>
      </div>
      <!-- Modo oscuro -->
      <div class="relative hidden h-full w-full bg-slate-950 dark:block">
        <div
          class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_0%,#000_70%,transparent_100%)]"
        >
        </div>
      </div>
    </div>
    <Languages />
    {showHeader && <Header />}
    <slot />
    <Footer/>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }

  html {
    font-family: "Onest Variable", sans-serif;
    scroll-behavior: smooth;
  }

  /* Contenido bilingüe: se renderizan ambos idiomas y se muestra el de <html lang> */
  html[lang="en"] [data-lang="es"],
  html:not([lang="en"]) [data-lang="en"] {
    display: none !important;
  }

  /* Transición entre páginas: la imagen de la card se expande hacia el detalle */
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  body {
    color: rgba(17, 17, 17, 0.9);
    margin: 0;
    display: flex;
    justify-content: center;
    flex-direction: column;
    min-height: 100vh;
    overscroll-behavior: none;
  }

  h1 {
    font-size: 2em;
    margin: 0.67em 0;
  }

  a {
    background-color: transparent;
  }
</style>
